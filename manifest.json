{
  "manifest_version": 3,
  "name": "History Insights Chatbot",
  "version": "1.0",
  "permissions": ["history", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; connect-src 'self' http://localhost:11434 https://generativelanguage.googleapis.com"
  }
}